static inline void LED_InitPins(void);
static inline void LED_Set(uint8_t idx, bool on);
static void        LED_ApplyPWM(void);
static void        LED_FadeStep(void);
/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
static inline void LED_InitPins(void)
{
  /* If CubeMX already set PB12..PB15 as outputs, this is optional.
     Safe to call anyway. */
  GPIO_InitTypeDef gi = {0};
  __HAL_RCC_GPIOB_CLK_ENABLE();
  gi.Pin   = GPIO_PIN_12 | GPIO_PIN_13 | GPIO_PIN_14 | GPIO_PIN_15;
  gi.Mode  = GPIO_MODE_OUTPUT_PP;
  gi.Pull  = GPIO_NOPULL;
  gi.Speed = GPIO_SPEED_FREQ_LOW;
  HAL_GPIO_Init(GPIOB, &gi);

  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12 | GPIO_PIN_13 | GPIO_PIN_14 | GPIO_PIN_15, GPIO_PIN_RESET);
}

static inline void LED_Set(uint8_t idx, bool on)
{
  uint16_t pin;
  switch(idx) {
    case 0: pin = GPIO_PIN_12; break;
    case 1: pin = GPIO_PIN_13; break;
    case 2: pin = GPIO_PIN_14; break;
    default: pin = GPIO_PIN_15; break;
  }

  HAL_GPIO_WritePin(GPIOB, pin, on ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

/* Called every TIM6 update (TIM6_TICK_HZ). Implements 6-bit software PWM. */
static void LED_ApplyPWM(void)
{
  uint8_t p = pwm_phase;

  /* Compare each LED's brightness against the phase */
  for (uint8_t i = 0; i < 4; i++) {
    LED_Set(i, bright[i] > p); // active-high LEDs
  }

  /* Next duty slice */
  p++;
  if (p >= PWM_LEVELS) {
    p = 0;
    /* Completed one PWM period (~1ms). Time to possibly step the fades. */
    if (++period_acc >= FADE_STEP_PERIODS) {
      period_acc = 0;
      LED_FadeStep();
    }
  }
  pwm_phase = p;
}

/* One LED fades up to BRIGHT_MAX, then down to 0, then we advance to next LED */
static void LED_FadeStep(void)
{
  uint8_t b = bright[active_led];
  int8_t  d = dir;

  int16_t nb = (int16_t)b + d;
  if (nb >= BRIGHT_MAX) {
    nb = BRIGHT_MAX; d = -1;     // reached top; start fading down
  } else if (nb <= 0) {
    nb = 0; d = +1;               // reached bottom; move to next LED and fade up
    active_led = (uint8_t)((active_led + 1) & 0x03);
  }
  bright[active_led] = (uint8_t)nb;

  /* Keep others off when we're focusing a single LED for a clean 'chase' */
  for (uint8_t i = 0; i < 4; i++) {
    if (i != active_led) bright[i] = 0;
  }
  dir = d;
}
/* USER CODE END 0 */

